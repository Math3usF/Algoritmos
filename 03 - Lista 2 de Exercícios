    "def menu():\n",
    "    #Opções da Lista\n",
    "    print(\"Bem vindo a sua Lista de Tarefas\")\n",
    "    print(\"1. Adicionar tarefa\")\n",
    "    print(\"2. Listar todas as tarefas\")\n",
