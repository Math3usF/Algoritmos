    "\n",
    "\n",
    "def lista_tarefas():\n",
    "    tarefas = []\n",
    "\n",
    "    #Criação do Loop infinito\n",
    "    while True:\n",
    "        opcao = menu()\n",
    "        #Passo 1 Adicionar tarefa\n",
    "        if opcao == \"1\":\n",
    "            nome = input(\"Digite sua tarefa: \")\n",
    "            tarefa = {\"nome\": nome, \"feito\": False}\n",
