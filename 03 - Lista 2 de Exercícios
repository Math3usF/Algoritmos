    "                print(\"Minhas Tarefas: \")\n",
    "                for i, tarefa in enumerate(tarefas):\n",
    "                    status = \"FEITO\" if tarefa[\"feito\"] else \"Espera\"\n",
    "                    print (f\"{i + 1}. [{status}]{tarefa['nome']}\")\n",
    "        # passo 3 Marcar como concluido\n",
