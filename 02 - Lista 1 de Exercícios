#34
def fatorial(n):
    if n == 0 or n == 1:
        return 1
    return n * fatorial(n - 1)

# Utilizador insere o número
num = int(input("Qual número deseja saber o fatorial? "))
print(f"O fatorial de {num} é {fatorial(num)}")

