#32
def n_primo(n):
    if n < 2: return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0: return False
    return True

# insere o valor
num = int(input("Insira um número: "))
if n_primo(num):
    print(f"O número {num} é primo!")
else:
    print(f"O número {num} NÃO é primo.")

